# Discord Bot Token
DISCORD_TOKEN=your_bot_token_here

# MongoDB Connection
MONGO_URI=mongodb://localhost:27017
MONGO_DB=lastcall

# Default Prefix
DEFAULT_PREFIX=!

# Seconds of warning before a timer disconnects someone.
# Capped at a third of the timer, so short timers still get a usable warning.
WARN_SECONDS=60

# Slash commands are synced automatically whenever the command set changes.
# Set this to 1 to force a sync on the next start.
SYNC_ON_START=

# Days to keep tracked events before they expire. Leave unset to keep them
# forever, which at roughly 200 bytes an event is affordable for a long time.
EVENT_RETENTION_DAYS=

# Bot Links (optional)
BOT_INVITE_URL=
SUPPORT_SERVER_URL=

# Comma-separated owner IDs (optional)
OWNER_IDS=
